---
import '../styles/tokens.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="process wrap" data-reveal>
  <span class="sec-eyebrow">{t('process.eyebrow')}</span>
  <h2 class="sec-title">{t('process.title')}</h2>

  <div class="process-list">
    <div class="process-item">
      <div class="process-num">01</div>
      <div class="process-text">
        <h4>{t('process.1.title')}</h4>
        <p>{t('process.1.desc')}</p>
      </div>
    </div>
    <div class="process-item">
      <div class="process-num">02</div>
      <div class="process-text">
        <h4>{t('process.2.title')}</h4>
        <p>{t('process.2.desc')}</p>
      </div>
    </div>
    <div class="process-item">
      <div class="process-num">03</div>
      <div class="process-text">
        <h4>{t('process.3.title')}</h4>
        <p>{t('process.3.desc')}</p>
      </div>
    </div>
    <div class="process-item">
      <div class="process-num">04</div>
      <div class="process-text">
        <h4>{t('process.4.title')}</h4>
        <p>{t('process.4.desc')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    padding-top: 30px;
    padding-bottom: 70px;
  }
  .process-list {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
  }
  .process-item {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 0.5px solid var(--line);
  }
  .process-item:first-child {
    border-top: 0.5px solid var(--line);
  }
  .process-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--amber);
    flex-shrink: 0;
    width: 28px;
  }
  .process-text h4 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 3px;
    color: var(--cream);
  }
  .process-text p {
    font-size: 13.5px;
    color: var(--cream-dim);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
