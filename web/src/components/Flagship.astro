---
import '../styles/tokens.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flagship wrap" data-reveal>
  <span class="sec-eyebrow">{t('flagship.eyebrow')}</span>
  <h2 class="sec-title">{t('flagship.title')}</h2>
  <p class="sec-desc">{t('flagship.desc')}</p>

  <div class="fl-grid">
    <!-- Copy + CTA -->
    <div class="fl-copy">
      <span class="fl-tag"><span class="fl-dot"></span>{t('flagship.badge')}</span>
      <h3>BlockFlow</h3>
      <p>{t('flagship.body')}</p>
      <ul class="fl-points">
        <li>{t('flagship.p1')}</li>
        <li>{t('flagship.p2')}</li>
        <li>{t('flagship.p3')}</li>
      </ul>
      <a class="fl-cta" href="https://www.blockflow.uk/#how" target="_blank" rel="noopener">
        {t('flagship.cta')} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Product mockup (dark, coherent with the rest) -->
    <div class="fl-mock">
      <div class="fl-bar">
        <span class="d r"></span><span class="d y"></span><span class="d g"></span>
        <span class="fl-url">blockflow.uk</span>
      </div>
      <div class="fl-body">
        <div class="fl-call">
          <span class="fl-wave"></span>
          <span>{t('flagship.mock.call')}</span>
        </div>
        <div class="fl-bubble">{t('flagship.mock.said')}</div>
        <div class="fl-ai"><span class="fl-ai-tag">IA</span> {t('flagship.mock.triage')}</div>
        <div class="fl-ticket">
          <span class="fl-ref">EMG-482913</span>
          <span class="fl-b">Kensington Court</span>
          <span class="fl-chip">{t('flagship.mock.raised')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .flagship { padding-top: 30px; padding-bottom: 70px; }
  .fl-grid { display: grid; grid-template-columns: 1fr; gap: 24px; margin-top: 32px; align-items: center; }

  .fl-copy { }
  .fl-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 11px; color: var(--cream-dim);
    border: 0.5px solid var(--line-strong); padding: 5px 12px; border-radius: 20px;
    margin-bottom: 16px;
  }
  .fl-dot { width: 6px; height: 6px; border-radius: 50%; background: #1D9E75; box-shadow: 0 0 0 3px rgba(29,158,117,0.2); }
  .fl-copy h3 { font-family: var(--font-display); font-size: 30px; font-weight: 500; letter-spacing: -0.5px; margin-bottom: 12px; }
  .fl-copy > p { font-size: 14.5px; color: var(--cream-dim); line-height: 1.6; margin-bottom: 18px; }
  .fl-points { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .fl-points li { position: relative; padding-left: 22px; font-size: 13.5px; color: var(--cream); }
  .fl-points li::before {
    content: ""; position: absolute; left: 0; top: 6px;
    width: 8px; height: 8px; border-radius: 50%; background: var(--amber);
  }
  .fl-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-body); font-size: 14px; font-weight: 600;
    background: var(--amber); color: var(--bg);
    padding: 12px 20px; border-radius: 10px; text-decoration: none;
    transition: transform 0.15s ease;
  }
  .fl-cta:hover { transform: translateY(-2px); }

  /* mockup */
  .fl-mock {
    background: var(--bg-raised); border: 0.5px solid var(--line);
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(0,0,0,0.8);
  }
  .fl-bar { display: flex; align-items: center; gap: 6px; padding: 12px 16px; border-bottom: 0.5px solid var(--line); }
  .fl-bar .d { width: 9px; height: 9px; border-radius: 50%; }
  .fl-bar .d.r { background: #E24B4A; } .fl-bar .d.y { background: var(--amber); } .fl-bar .d.g { background: #1D9E75; }
  .fl-url { margin: 0 auto; font-family: var(--font-mono); font-size: 10.5px; color: var(--cream-faint); border: 0.5px solid var(--line); padding: 3px 26px; border-radius: 6px; }
  .fl-body { padding: 18px 16px; display: flex; flex-direction: column; gap: 10px; }
  .fl-call {
    display: flex; align-items: center; gap: 9px;
    background: var(--bg); border: 0.5px solid var(--line); border-radius: 10px;
    padding: 10px 12px; font-family: var(--font-mono); font-size: 11.5px; color: var(--cream-dim);
  }
  .fl-wave { width: 8px; height: 8px; border-radius: 50%; background: #1D9E75; box-shadow: 0 0 0 3px rgba(29,158,117,0.25); }
  .fl-bubble {
    align-self: flex-start; max-width: 88%;
    background: var(--bg); border: 0.5px solid var(--line); border-radius: 12px;
    padding: 10px 12px; font-size: 12.5px; color: var(--cream); line-height: 1.4;
  }
  .fl-ai {
    align-self: flex-end; max-width: 88%;
    background: var(--amber-dim); border: 0.5px solid rgba(250,199,117,0.3); border-radius: 12px;
    padding: 9px 12px; font-size: 12.5px; color: var(--amber); font-weight: 500;
  }
  .fl-ai-tag { font-family: var(--font-mono); font-size: 9px; font-weight: 700; background: var(--amber); color: var(--bg); padding: 1px 6px; border-radius: 5px; margin-right: 6px; }
  .fl-ticket {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    background: var(--bg); border: 0.5px solid var(--line); border-radius: 10px; padding: 11px 12px;
  }
  .fl-ref { font-family: var(--font-mono); font-size: 12px; color: var(--amber); font-weight: 500; }
  .fl-b { font-size: 12px; color: var(--cream-dim); }
  .fl-chip { margin-left: auto; font-family: var(--font-mono); font-size: 10px; padding: 3px 9px; border-radius: 6px; background: rgba(93,202,165,0.14); color: #5dcaa5; white-space: nowrap; }

  [data-reveal] { opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s ease; }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }

  @media (min-width: 768px) {
    .fl-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
</style>
