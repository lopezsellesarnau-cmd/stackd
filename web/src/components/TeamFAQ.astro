---
import '../styles/tokens.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="team wrap" id="equipo" data-reveal>
  <span class="sec-eyebrow">{t('team.eyebrow')}</span>
  <h2 class="sec-title">{t('team.title')}</h2>
  <p class="sec-desc">{t('team.desc')}</p>

  <div class="team-grid">

    <div class="team-card">
      <div class="team-whoami">$ whoami<br />&gt; <span class="amber">arnau</span></div>
      <h4>Arnau</h4>
      <span class="team-role">{t('team.arnau.role')}</span>
      <p class="bio">{t('team.arnau.bio')}</p>
    </div>

    <div class="team-card">
      <div class="team-whoami">$ whoami<br />&gt; <span class="amber">ezequiel</span></div>
      <h4>Ezequiel</h4>
      <span class="team-role">{t('team.ezequiel.role')}</span>
      <p class="bio">{t('team.ezequiel.bio')}</p>
      <a href="https://ezequielmenor.es" class="team-link" target="_blank" rel="noopener">ezequielmenor.es</a>
    </div>

    <div class="team-card">
      <div class="team-whoami">$ whoami<br />&gt; <span class="amber">mateo</span></div>
      <h4>Mateo</h4>
      <span class="team-role">{t('team.mateo.role')}</span>
      <p class="bio">{t('team.mateo.bio')}</p>
    </div>

  </div>
</section>

<section class="faq wrap" id="faq" data-reveal>
  <span class="sec-eyebrow">{t('faq.eyebrow')}</span>
  <h2 class="sec-title">{t('faq.title')}</h2>

  <div class="faq-list">
    <div class="faq-item">
      <div class="faq-q">{t('faq.1.q')}</div>
      <div class="faq-a">{t('faq.1.a')}</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">{t('faq.2.q')}</div>
      <div class="faq-a">{t('faq.2.a')}</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">{t('faq.3.q')}</div>
      <div class="faq-a">{t('faq.3.a')}</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">{t('faq.4.q')}</div>
      <div class="faq-a">{t('faq.4.a')}</div>
    </div>
  </div>
</section>

<style>
  .team {
    padding-top: 30px;
    padding-bottom: 70px;
  }
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 32px;
  }
  .team-card {
    background: var(--bg-raised);
    border: 0.5px solid var(--line);
    border-radius: 14px;
    padding: 20px;
  }
  .team-whoami {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cream-faint);
    margin-bottom: 10px;
    line-height: 1.6;
  }
  .team-whoami .amber {
    color: var(--amber);
  }
  .team-card h4 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 6px;
    color: var(--cream);
  }
  .team-role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--amber);
    margin-bottom: 10px;
    display: block;
  }
  .bio {
    font-size: 13.5px;
    color: var(--cream-dim);
  }
  .team-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 12px;
    color: var(--cream-faint);
    text-decoration: none;
    font-family: var(--font-mono);
    transition: color 0.2s;
  }
  .team-link:hover {
    color: var(--amber);
  }

  .faq {
    padding-top: 30px;
    padding-bottom: 70px;
  }
  .faq-list {
    margin-top: 28px;
  }
  .faq-item {
    border-bottom: 0.5px solid var(--line);
    padding: 18px 0;
  }
  .faq-item:first-child {
    border-top: 0.5px solid var(--line);
  }
  .faq-q {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--cream);
  }
  .faq-a {
    font-size: 13.5px;
    color: var(--cream-dim);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
