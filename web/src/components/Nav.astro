---
import '../styles/tokens.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const switchHref = getLocalizedPath(otherLang, '/');
---

<header class="nav-wrap wrap">
  <nav class="nav">
    <div class="nav-brand">
      <Image src={logo} alt="StackD" width={26} />
      <span>StackD</span>
    </div>
    <div class="nav-links">
      <a href="#servicios">{t('nav.servicios')}</a>
      <a href="#proyectos">{t('nav.proyectos')}</a>
      <a href="#equipo">{t('nav.equipo')}</a>
      <a href="#faq">{t('nav.faq')}</a>
    </div>
    <a href={switchHref} class="lang-switch" aria-label="Switch language">{t('lang.switch')}</a>
    <a href="#contacto" class="nav-cta">{t('nav.cta')}</a>
  </nav>
</header>

<style>
  .nav-wrap {
    position: relative;
    z-index: 10;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .nav-brand :global(img) {
    width: 26px;
    height: auto;
  }
  .nav-brand span {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--cream);
  }
  .nav-links {
    display: none;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--cream-dim);
  }
  .nav-links a {
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--amber);
  }
  .nav-cta {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--bg);
    background: var(--amber);
    padding: 9px 16px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .lang-switch {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--cream-dim);
    border: 0.5px solid var(--line-strong);
    padding: 7px 11px;
    border-radius: 7px;
    text-decoration: none;
    white-space: nowrap;
    margin-left: auto;
    margin-right: 10px;
    transition: color 0.2s, border-color 0.2s;
  }
  .lang-switch:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
</style>
